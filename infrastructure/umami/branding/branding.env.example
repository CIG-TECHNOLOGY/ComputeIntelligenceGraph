# Public branding and routing inputs for the small Umami UI patchset.
#
# These values are deliberately separate from the database and application
# secrets in ../.env.example. They are safe to put in deployment configuration,
# but each URL must be reviewed as a customer-visible production endpoint.
# Do not use a repository-root .env for deployment values.

# Build-time UI branding. The stock upstream image does not read these values;
# they are consumed only by the version-locked patchset documented in
# upstream-patchset.md.
UMAMI_BRAND_NAME=CIG Analytics
UMAMI_BRAND_HOME_URL=https://www.example.com
UMAMI_BRAND_LOGO_URL=https://static.example.com/cig-analytics/logo.svg
UMAMI_BRAND_FAVICON_URL=https://static.example.com/cig-analytics/favicon.ico
UMAMI_BRAND_DOCS_URL=https://docs.example.com/analytics
UMAMI_BRAND_SUPPORT_URL=https://support.example.com/analytics

# Public ingress contract. Configure these in the reverse proxy/CDN, not as
# credentials and not as an authorization allowlist.
UMAMI_APP_ORIGIN=https://analytics.example.com
UMAMI_TRACKER_ORIGIN=https://cdn.example.com
UMAMI_TRACKER_SCRIPT_PATH=/tag.js
UMAMI_COLLECT_PATH=/collect

# Runtime upstream option: used for favicons of *tracked customer websites*.
# It is not the CIG Analytics application favicon. Keep the {{domain}}
# placeholder so Umami can substitute a tracked website's hostname.
UMAMI_WEBSITE_FAVICON_SERVICE_URL=https://icons.example.com/{{domain}}.ico
