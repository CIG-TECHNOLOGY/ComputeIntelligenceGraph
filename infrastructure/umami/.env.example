# Copy this file to .env and replace every placeholder before starting Umami.
# Do not commit .env or use this local Compose configuration for production.

# DML-only role used by the long-running Umami service. Do not grant DDL.
UMAMI_RUNTIME_DATABASE_URL=postgresql://runtime_user:replace-me@postgres.example.internal:5432/analytics
# DDL-capable, direct PostgreSQL role used only by `umami-migrate`.
UMAMI_MIGRATION_DATABASE_URL=postgresql://migration_user:replace-me@postgres.example.internal:5432/analytics
UMAMI_APP_SECRET=replace-with-openssl-rand-hex-32-output

# Optional: required only when enabling Umami's built-in two-factor authentication.
UMAMI_TWO_FACTOR_ENCRYPTION_KEY=
