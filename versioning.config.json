{
  "rootPackageJson": "package.json",
  "packages": [
    "apps/dashboard",
    "apps/docs",
    "apps/landing",
    "apps/docs", 
    "apps/wizard-ui",
    "packages/agents",
    "packages/api",
    "packages/chatbot",
    "packages/config",
    "packages/discovery",
    "packages/graph",
    "packages/sdk"
  ],
  "changelogFile": "CHANGELOG.md",
  "conventionalCommits": true,
  "syncDependencies": true,
  "ignorePackages": [
    "@cig-technology/cli",
    "@cig/iac",
    "@cig-technology/i18n"
  ],
  "extensionConfig": {
    "secrets-check": {
      "enabled": true,
      "allowlist": [
        "=$${",
        "$${DB_PASS}",
        "$${NEXTAUTH_SECRET}",
        "$${SMTP_PASS}",
        "$${AUTHENTIK_CLIENT_ID_VAL}",
        "$${AUTHENTIK_CLIENT_SECRET_VAL}",
        "${github_auth_client_secret}",
        "${smtp_password}",
        "$(secret \"$ADMIN_PASSWORD_ID\")",
        "$(secret \"$DB_PASSWORD_ID\")",
        "AUTHENTIK_EMAIL__PASSWORD=$SMTP_PASSWORD",
        "$${PG_PASS}",
        "$${AUTHENTIK_BOOTSTRAP_PASSWORD}",
        "${infisical_token}",
        "export INFISICAL_TOKEN=\"$INFISICAL_TOKEN\"",
        "infisical secrets get FORGEJO_RUNNER_TOKEN",
        "${authentik_client_secret}",
        "$(openssl rand -hex 24)",
        "${POSTGRES_PASSWORD}",
        "process.env.INFISICAL_ADMIN_PASSWORD",
        "env.AWS_SESSION_TOKEN",
        "SMTP_PASSWORD=***",
        "= var.smtp_password",
        "smtp_password = \"changeme\"",
        "${var.smtp_password}",
        "${google_auth_client_secret}",
        "$(gcloud auth application-default print-access-token)",
        "AUTHENTIK_CLIENT_SECRET=newsecret",
        "env.GIT_CI_AUTHENTIK_CLIENT_SECRET",
        "env.GIT_CI_ADMIN_TOKEN"
      ]
    },
    "workspace-env": {
      "enabled": true,
      "manifestPath": "config/env/manifest.cjs"
    },
    "workspace-scripts": {
      "enabled": true,
      "runner": "concurrently",
      "apps": {
        "apps/dashboard": {
          "name": "dashboard",
          "scripts": ["dev", "build", "test", "lint"]
        },
        "apps/docs": {
          "name": "docs",
          "scripts": ["dev", "build", "test"]
        },
        "apps/landing": {
          "name": "landing",
          "scripts": ["dev", "build"]
        },
        "apps/wizard-ui": {
          "name": "wizard",
          "scripts": ["dev", "build"]
        },
        "packages/api": {
          "name": "api",
          "scripts": ["dev", "build", "test", "start"]
        },
        "packages/agents": {
          "name": "agents",
          "scripts": ["dev", "build", "test"]
        },
        "packages/chatbot": {
          "name": "chatbot",
          "scripts": ["dev", "build", "test"]
        },
        "packages/cli": {
          "name": "cli",
          "scripts": ["dev", "build", "test"]
        },
        "packages/config": {
          "name": "config",
          "scripts": ["dev", "build", "test"]
        },
        "packages/discovery": {
          "name": "discovery",
          "scripts": ["dev", "build", "test"]
        },
        "packages/graph": {
          "name": "graph",
          "scripts": ["dev", "build", "test"]
        },
        "packages/sdk": {
          "name": "sdk",
          "scripts": ["dev", "build", "test"]
        }
      },
      "scripts": {
        "dev": {
          "enabled": true,
          "prefix": "dev:",
          "description": "Start development mode"
        },
        "build": {
          "enabled": true,
          "prefix": "build:",
          "description": "Build for production"
        },
        "test": {
          "enabled": true,
          "prefix": "test:",
          "description": "Run tests"
        },
        "lint": {
          "enabled": true,
          "prefix": "lint:",
          "description": "Run linter"
        },
        "start": {
          "enabled": true,
          "prefix": "start:",
          "description": "Start production server"
        }
      },
      "autoDetect": true,
      "postSyncHook": true
    }
  },
  "cleanup": {
    "enabled": true,
    "patterns": [
      "**/node_modules",
      "**/dist",
      "**/.next",
      "**/.turbo",
      "**/coverage",
      "**/*.log",
      "**/.DS_Store"
    ],
    "dryRun": false
  },
  "branchAwareness": {
    "enabled": true,
    "defaultBranch": "main",
    "branches": {
      "main": {
        "versionFormat": "semantic",
        "tagFormat": "v{version}",
        "syncFiles": [
          "package.json"
        ],
        "environment": "production",
        "bumpStrategy": "semantic"
      },
      "develop": {
        "versionFormat": "dev",
        "tagFormat": "v{version}-dev",
        "syncFiles": [
          "package.json"
        ],
        "environment": "development",
        "bumpStrategy": "dev-build"
      }
    }
  }
}
