# Generated by @edcalderon/versioning workspace-env. Do not edit directly.
# Example env for target infra

# Public CIG analytics collection endpoint injected into the tracker
ANALYTICS_COLLECTOR_URL=http://localhost:8080/api/v1/analytics/collect
# Analytics website provisioning mode (local rehearsal or upstream Umami)
ANALYTICS_PROVISIONING_MODE=local
# Assign public IPs to API tasks when the private egress path is unavailable
API_ASSIGN_PUBLIC_IP=false
# AWS Secrets Manager ARN for the API OpenAI key
API_OPENAI_API_KEY_SECRET_ARN=arn:aws:secretsmanager:us-east-2:123456789012:secret:cig/api/openai
# AWS Secrets Manager ARN containing the server-side Umami API token
API_UMAMI_API_TOKEN_SECRET_ARN=arn:aws:secretsmanager:us-east-2:123456789012:secret:cig/prod/umami/provisioner-token
# Authentik admin email
AUTHENTIK_ADMIN_EMAIL=<YOUR_AUTHENTIK_ADMIN_EMAIL>
# Authentik domain
AUTHENTIK_DOMAIN=<YOUR_AUTHENTIK_DOMAIN>
# Authentik subnet ID
AUTHENTIK_SUBNET_ID=subnet-1234567890
# Authentik VPC ID
AUTHENTIK_VPC_ID=vpc-1234567890
# AWS account ID
AWS_ACCOUNT_ID=123456789012
# AWS CLI profile
AWS_PROFILE=default
# AWS region
AWS_REGION=us-east-2
# AWS role ARN
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/cig
# Whether dashboard integrates with Authentik
DASHBOARD_AUTHENTIK_INTEGRATION=true
# Dashboard build output path
DASHBOARD_BUILD_PATH=./apps/dashboard/out
# Dashboard domain
DASHBOARD_DOMAIN=dashboard.example.com
# Compute module name
IAC_COMPUTE_MODULE=compute
# Terraform modules base path
IAC_MODULES_PATH=./packages/iac/modules
# Networking module name
IAC_NETWORKING_MODULE=networking
# Application log level
LOG_LEVEL=info
# Whether structured logs include timestamps
LOG_TIMESTAMPS=true
# Private Umami API base URL used by the control plane
UMAMI_API_URL=http://localhost:3000
# Optional Umami team identifier for provisioned websites
UMAMI_TEAM_ID=
