# GCP Service Account Environment Variables
# Source this file to isolate gcloud per terminal session

# Isolate gcloud config directory for this session
export CLOUDSDK_CONFIG=~/.gcloud-cig-lat-tech

# Set service account credentials
export GOOGLE_APPLICATION_CREDENTIALS=/home/ed/Documents/MAESTRIA/SISTEMAS_INTELIGENTES/CIG-2/config/env/private.gcloud.json

# Set active project (must be project ID, not name)
export CLOUDSDK_CORE_PROJECT=cig-technology-495016

# Service account email
export CLOUDSDK_CORE_ACCOUNT=cig-technology@cig-technology-495016.iam.gserviceaccount.com

# Vertex AI configuration (consumes $300 free credits via GCP billing)
export GOOGLE_CLOUD_PROJECT=cig-technology-495016
export VERTEX_LOCATION=us-central1
export GENAI_USE_VERTEXAI=true

# Set default region/zone if needed
export CLOUDSDK_COMPUTE_REGION=us-central1
export CLOUDSDK_COMPUTE_ZONE=us-central1-a

echo "✅ GCloud environment configured for cig-lat project"
echo "Config directory: $CLOUDSDK_CONFIG"
echo "Project: $CLOUDSDK_CORE_PROJECT"
echo "Account: $CLOUDSDK_CORE_ACCOUNT"
